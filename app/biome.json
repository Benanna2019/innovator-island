{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "css": { "linter": { "enabled": false } },
  "files": {
    "includes": ["**", "!**/_generated", "!**/routeTree.gen.ts", "!**/public", "!**/docs", "!**/dist", "!worker-configuration.d.ts"]
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true, "complexity": { "noStaticOnlyClass": "off" } }
  }
}
